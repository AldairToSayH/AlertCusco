{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'phone'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().matches(/^\\+?[0-9]{7,15}$/)"
        },
        "contactName": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80"
        },
        "contactNumber": {
          ".validate": "newData.isString() && newData.val().matches(/^\\+?[0-9]{7,15}$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
